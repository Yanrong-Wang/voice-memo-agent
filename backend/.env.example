# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Optional vocabulary/context hint for names and domain-specific terminology.
# OPENAI_TRANSCRIPTION_PROMPT=Preserve exact product, person, and technical names.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
SEMANTIC_MIN_SCORE=0.15
HYBRID_SEARCH_ENABLED=true
RAG_RERANK_ENABLED=true

# Optional precise word alignment. This transitional provider uses whisper-1,
# which OpenAI has announced will shut down on 2027-02-26. Leave empty to use
# estimated sentence timestamps, or replace it with a local aligner in production.
OPENAI_TIMESTAMP_MODEL=whisper-1

# Upload protection. The default matches the transcription API file limit.
MAX_AUDIO_UPLOAD_BYTES=26214400
MAX_RECORDING_DURATION_SECONDS=14400

# Durable analysis jobs and rate limiting.
REDIS_URL=redis://127.0.0.1:6380/0
ANALYSIS_QUEUE_ENABLED=true
ANALYSIS_JOB_TIMEOUT_SECONDS=900
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Leave empty for local development. Deployed services must use a real user
# identity provider; this shared token is only a minimum perimeter control.
API_BEARER_TOKEN=
# Production OIDC/JWT verification. When JWT_JWKS_URL is set, Bearer tokens are
# verified against the provider's public keys and scoped by the `sub` claim.
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
SESSION_STORE_PROVIDER=postgres

# Recommended persistent store. Start it with:
# docker compose -f backend/docker-compose.yml up -d
VECTOR_STORE_PROVIDER=pgvector
POSTGRES_CONNECTION_STRING=postgresql+psycopg://voice_memo:voice_memo@127.0.0.1:5432/voice_memo
RAG_COLLECTION_NAME=voice_memo_transcript_chunks

# Zero-setup fallback:
# VECTOR_STORE_PROVIDER=chroma
# RAG_DATA_DIRECTORY=/absolute/path/to/chroma
