# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
SEMANTIC_MIN_SCORE=0.20

# Recommended persistent store. Start it with:
# docker compose -f backend/docker-compose.yml up -d
VECTOR_STORE_PROVIDER=pgvector
POSTGRES_CONNECTION_STRING=postgresql+psycopg://voice_memo:voice_memo@127.0.0.1:5432/voice_memo
RAG_COLLECTION_NAME=voice_memo_transcript_chunks

# Zero-setup fallback:
# VECTOR_STORE_PROVIDER=chroma
# RAG_DATA_DIRECTORY=/absolute/path/to/chroma
